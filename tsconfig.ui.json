{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/dashboard/ui/**/*.ts",
    "src/dashboard/ui/**/*.svelte",
    ".svelte-kit/types/**/*.d.ts",
    "src/assets.d.ts"
  ]
}
