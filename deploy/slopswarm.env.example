# /etc/slopswarm/slopswarm.env on the VPS (root-only, 0600). Every secret of the hosted setup lives here (and
# /etc/slopswarm/secrets/codex/auth.json). Never commit a filled copy. See docs/deploy.md.

# Model and tool credentials (swarm-only accounts; rotation checklist in README).
CLAUDE_CODE_OAUTH_TOKEN=
OPEN_ROUTER_API_KEY=
EXA_API_KEY=
SWARM_GITHUB_TOKEN=

# The forges' admin login (yours).
FORGE_ADMIN_USER=operator
FORGE_ADMIN_PASSWORD=

# The agent host's runner, over the tailnet (`just runner` there with the same RUNNER_TOKEN).
SLOPSWARM_RUNNER_URL=http://<agent-host-tailnet-name>:7701
RUNNER_TOKEN=

# Dashboard + API: localhost and the VPS's tailnet address; scripts and CI send this bearer token.
SLOPSWARM_BIND=127.0.0.1,<vps-tailnet-ip>
# Names the dashboard/API answers to besides its addresses (requests for other Host names are refused): its MagicDNS name.
SLOPSWARM_ALLOWED_HOSTS=<vps-tailnet-name>,<vps-tailnet-name>.<tailnet>.ts.net
SLOPSWARM_API_TOKEN=
PORT=7777

# Forges: the first host port, and the tailnet address their forwarders also publish on (remote agent hosts).
FORGE_PORT=3301
SLOPSWARM_FORGE_PUBLISH=<vps-tailnet-ip>

# The public read-only forge (§7). Unlisted: only here. Leave empty until §7 goes live.
PUBLIC_FORGE_DOMAIN=
ACME_EMAIL=

# Backups: copies kept, and the UTC hour of the nightly one.
SLOPSWARM_BACKUP_KEEP=7
SLOPSWARM_BACKUP_HOUR_UTC=3
