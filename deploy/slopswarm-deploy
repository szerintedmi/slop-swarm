#!/bin/sh
# Deploy on the VPS (docs/plans/2026-10-12-hosted-control-plane.md §6.4-6.5; docs/deploy.md). Installed as
# /usr/local/bin/slopswarm-deploy and run as root through a forced SSH command (the CI's key):
#   command="sudo /usr/local/bin/slopswarm-deploy",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 …
# SSH_ORIGINAL_COMMAND: deploy <controller image@digest> [<agent image@digest>] (sudoers keeps it: env_keep in
# /etc/sudoers.d/slopswarm-deploy, written by bootstrap.sh; without it the argument line is lost and this fails with usage).
# Also by hand, for a rollback: sudo slopswarm-deploy deploy <previous controller@digest> [<agent@digest>]
# The image carries this script too: when its copy differs, the deploy installs it here and re-runs itself with it, so
# a merged change reaches the VPS with the next deploy (bootstrap.sh only installs the first one).
#
# Deploys don't kill wakes: the controller gets SIGTERM, detaches (the run keeps going on the agent host), and the
# new controller resumes the run and follows its wakes. When the DB schema changes (the image's
# org.slopswarm.schema label), the deploy waits until no run is active.
set -eu

DIR=/opt/slopswarm
ENV_FILE=/etc/slopswarm/slopswarm.env
LOCK=/run/lock/slopswarm-deploy.lock
SELF=/usr/local/bin/slopswarm-deploy
WAIT_MAX_S=${SLOPSWARM_DEPLOY_WAIT_S:-21600}
IMAGE_RE='^ghcr\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$'

fail() { echo "deploy: $*" >&2; exit 1; }

# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-$*}
[ "${1:-}" = deploy ] || fail "usage: deploy <controller@sha256:…> [<agent@sha256:…>]"
CONTROLLER=${2:-}
AGENT=${3:-}
echo "$CONTROLLER" | grep -Eq "$IMAGE_RE" || fail "controller: expected ghcr.io/…@sha256:<digest>"
[ -z "$AGENT" ] || echo "$AGENT" | grep -Eq "$IMAGE_RE" || fail "agent: expected ghcr.io/…@sha256:<digest>"
[ -r "$ENV_FILE" ] || fail "$ENV_FILE missing"

mkdir -p "$DIR"
# A re-run with the image's copy of this script (below) inherits the lock on fd 9.
if [ -z "${SLOPSWARM_DEPLOY_REEXEC:-}" ]; then
  exec 9>"$LOCK"
  flock -n 9 || fail "another deploy is running"
fi

docker pull -q "$CONTROLLER" >/dev/null

# compose.yaml, the Caddyfile and this script ship inside the image.
cid=$(docker create "$CONTROLLER")
trap 'docker rm -f "$cid" >/dev/null 2>&1 || true' EXIT

# This script, from the image: install it when it differs and re-run with it (once). Written next to the old one and
# moved over it, so this shell keeps reading the old file. An image without it keeps the installed script.
if [ -z "${SLOPSWARM_DEPLOY_REEXEC:-}" ] && docker cp "$cid:/app/deploy/slopswarm-deploy" "$SELF.new" 2>/dev/null; then
  if cmp -s "$SELF.new" "$SELF"; then
    rm -f "$SELF.new"
  else
    chmod 0755 "$SELF.new"
    mv "$SELF.new" "$SELF"
    echo "deploy: installed the image's slopswarm-deploy; running it"
    docker rm -f "$cid" >/dev/null 2>&1 || true
    unset SSH_ORIGINAL_COMMAND
    SLOPSWARM_DEPLOY_REEXEC=1 exec "$SELF" deploy "$CONTROLLER" "$AGENT"
  fi
fi

# The previous images, for a rollback if the new controller doesn't come up.
PREV_CONTROLLER=""
PREV_AGENT=""
if [ -f "$DIR/image.env" ]; then
  PREV_CONTROLLER=$(sed -n 's/^SLOPSWARM_IMAGE=//p' "$DIR/image.env")
  PREV_AGENT=$(sed -n 's/^SLOPSWARM_AGENT_IMAGE=//p' "$DIR/image.env")
fi
[ -n "$AGENT" ] || AGENT=$PREV_AGENT

PORT=$(sed -n 's/^PORT=//p' "$ENV_FILE" | tail -n1)
PORT=${PORT:-7777}
api_live() {
  # 0 when a run is active (or the status can't be read), 1 when none is.
  s=$(curl -fsS "http://127.0.0.1:$PORT/api/v1/status" 2>/dev/null) || return 1
  echo "$s" | grep -q '"live":true'
}

new_schema=$(docker image inspect -f '{{index .Config.Labels "org.slopswarm.schema"}}' "$CONTROLLER")
old_schema=$(docker inspect -f '{{index .Config.Labels "org.slopswarm.schema"}}' slopswarm-controller 2>/dev/null || true)
if [ -n "$old_schema" ] && [ "$new_schema" != "$old_schema" ]; then
  waited=0
  while api_live; do
    [ "$waited" -lt "$WAIT_MAX_S" ] || fail "schema change and a run is still active after ${WAIT_MAX_S}s; stop it (just stop) and deploy again"
    [ "$waited" -eq 0 ] && echo "deploy: schema change: waiting until no run is active"
    sleep 60
    waited=$((waited + 60))
  done
fi

docker cp "$cid:/app/deploy/compose.yaml" "$DIR/compose.yaml.new"
docker cp "$cid:/app/deploy/Caddyfile" "$DIR/Caddyfile.new"
# A changed Caddyfile needs a Caddy restart: compose doesn't recreate it for a file's contents, and the single-file
# bind mount keeps the old inode after the mv.
CADDY_CHANGED=1
cmp -s "$DIR/Caddyfile.new" "$DIR/Caddyfile" 2>/dev/null && CADDY_CHANGED=""
mv "$DIR/compose.yaml.new" "$DIR/compose.yaml"
mv "$DIR/Caddyfile.new" "$DIR/Caddyfile"

write_images() {
  umask 077
  printf 'SLOPSWARM_IMAGE=%s\nSLOPSWARM_AGENT_IMAGE=%s\n' "$1" "$2" >"$DIR/image.env.new"
  mv "$DIR/image.env.new" "$DIR/image.env"
}
up() {
  profile=""
  # Caddy gets two variables, not the secrets file.
  (umask 077; grep -E '^(PUBLIC_FORGE_DOMAIN|ACME_EMAIL)=' "$ENV_FILE" >"$DIR/caddy.env" || true)
  grep -Eq '^PUBLIC_FORGE_DOMAIN=.+' "$ENV_FILE" && profile="--profile public"
  # shellcheck disable=SC2086
  docker compose -f "$DIR/compose.yaml" --env-file "$DIR/image.env" $profile up -d --remove-orphans
  if [ -n "$profile" ] && [ -n "$CADDY_CHANGED" ]; then
    docker restart slopswarm-caddy >/dev/null
    CADDY_CHANGED=""
  fi
}
healthy() {
  i=0
  while [ $i -lt 30 ]; do
    curl -fsS "http://127.0.0.1:$PORT/api/v1/runs" >/dev/null 2>&1 && return 0
    sleep 2
    i=$((i + 1))
  done
  return 1
}

write_images "$CONTROLLER" "$AGENT"
up
if healthy; then
  echo "deploy: controller $CONTROLLER is up"
  exit 0
fi
if [ -n "$PREV_CONTROLLER" ]; then
  echo "deploy: the new controller did not come up; rolling back to $PREV_CONTROLLER" >&2
  write_images "$PREV_CONTROLLER" "$PREV_AGENT"
  up
  healthy || fail "the rollback did not come up either; see docker logs slopswarm-controller"
fi
fail "the new controller did not come up; see docker logs slopswarm-controller"
