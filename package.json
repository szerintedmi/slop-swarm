{
  "name": "slop-swarm",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/dashboard/ui/lib/*"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --no-env-file --bun svelte-kit sync && bun --no-env-file --bun tsc --noEmit && bun --no-env-file --bun svelte-check --tsconfig tsconfig.ui.json",
