# Claude subscription token for agent containers: run `claude setup-token` (valid 1 year).
CLAUDE_CODE_OAUTH_TOKEN=
# OpenRouter key for pi agents (provider: openrouter). An agent can name another variable with `key_env`,
# e.g. one key per model setup for a separate credit limit.
OPEN_ROUTER_API_KEY=
# Data folder (DB, runs, transcripts). Default ./data; relative paths are relative to the repo root.
# Point it at another worktree's data to browse or report on those runs.
# SLOPSWARM_DATA_DIR=../other-worktree/data   # relative to the repo root; ~/ works too

# Your admin login for the runs' forges (http://127.0.0.1:3300). `just setup` generates the password.
FORGE_ADMIN_USER=operator
FORGE_ADMIN_PASSWORD=
# Host port of the forge if 3300 is taken (default: forge.port in the config).
# FORGE_PORT=3310

# Codex ChatGPT login is NOT here: copy ~/.codex/auth.json to secrets/codex/auth.json (gitignored).
